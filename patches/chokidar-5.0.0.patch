+     * and `_closePath`). Unobserved, its rejection reached the process-level
+     * `unhandledRejection` handler. It goes through `_handleError` like every
+     * other internal failure, so benign codes are still dropped and the rest
+     * arrive as an `error` event. Nothing is emitted once closed: `close()`
+     * removed every listener, and an `error` event with none throws.
+     * Drop this patch when upgrading to chokidar 6 or later.
+     */
+    _handleFloatingError(error) {
+        if (!this.closed)
+            this._handleError(error);
+    }
