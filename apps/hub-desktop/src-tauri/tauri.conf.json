{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MaxPrice Hub",
  "version": "0.4.0",
  "identifier": "com.maxprice.hub",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1421",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "cd ../.. && bun --filter @maxprice/hub build:binaries && bun --filter @maxprice/hub-desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "MaxPrice Hub",
        "label": "main",
        "width": 420,
        "height": 640,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": false
      },
      {
        "title": "MaxPrice Hub",
        "label": "popout",
        "width": 224,
        "height": 224,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/meschoening/MP-Updates/releases/latest/download/hub-latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCNTM3RTIyNkY3RTc0MzEKUldReGRINXZJbjVUdTliT3VoZW5kZHRseDMzY0JFSkcvR1gzbVd2eXo5ZWFaTlZLY2p5WnhaV2cK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/maxprice-hub", "binaries/maxprice-credstore"],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "Operator console for the MaxPrice usage hub",
    "longDescription": "The always-on usage hub for MaxPrice, packaged as a tray app with a compact operator console — hub status, connected clients, and claude.ai key health."
  }
}
