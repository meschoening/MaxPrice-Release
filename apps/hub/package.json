{
  "name": "@maxprice/hub",
  "version": "0.9.4",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./src/server.ts",
    "./auth": "./src/auth.ts",
    "./fanout": "./src/fanout.ts",
    "./machine-directory": "./src/machine-directory.ts",
    "./label-directory": "./src/label-directory.ts",
    "./membership-assertion-directory": "./src/membership-assertion-directory.ts",
    "./organization-roster": "./src/organization-roster.ts",
    "./poll-set": "./src/poll-set.ts",
    "./key-wiring": "./src/index.ts",
    "./key-store": "./src/key-store.ts",
    "./sample-stamps": "./src/sample-stamps.ts",
    "./gateway-drainer": "./src/gateway-drainer.ts",
    "./gateway-records": "./src/gateway-records.ts",
    "./gateway-registry": "./src/gateway-registry.ts"
  },
  "imports": {
    "#page-manifest": {
      "maxprice-hub-page": "./generated/page-manifest.ts",
      "default": "./src/page-manifest.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "build:credstore": "cargo build --release --locked --manifest-path credstore/Cargo.toml",
    "build:binaries": "bun run scripts/build-binaries.ts",
    "typecheck": "tsc --noEmit",
    "test": "TZ=America/Chicago bun test"
  },
  "dependencies": {
    "@maxprice/shared": "workspace:*",
    "@maxprice/usage-core": "workspace:*",
    "hono": "4.12.19",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0"
  }
}
