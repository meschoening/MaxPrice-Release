{
  "name": "@maxprice/hub",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./src/server.ts",
    "./auth": "./src/auth.ts",
    "./fanout": "./src/fanout.ts",
    "./machine-directory": "./src/machine-directory.ts"
  },
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "build:credstore": "cargo build --release --locked --manifest-path credstore/Cargo.toml",
    "build:binaries": "bun run scripts/build-binaries.ts",
    "typecheck": "tsc --noEmit",
    "test": "TZ=America/Chicago bun test"
  },
  "dependencies": {
    "@maxprice/shared": "workspace:*",
    "@maxprice/usage-core": "workspace:*",
    "hono": "4.12.19",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0"
  }
}
